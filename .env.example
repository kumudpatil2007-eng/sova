# SovereignAI Workbench Air-Gapped Environment Configuration
PROJECT_NAME="SovereignAI Workbench"
VERSION="1.0.0"
AIR_GAPPED_MODE=true
ENVIRONMENT=on-premise-production

# Security & Secret Key
SECRET_KEY="sovereign-ai-workbench-super-secret-enterprise-key-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database
DATABASE_URL="sqlite+aiosqlite:///./storage/sovereign.db"

# Local Open-Weight Models (Ollama / vLLM local endpoints)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
DEFAULT_VISION_MODEL="qwen2.5-vl:7b"
DEFAULT_CODE_MODEL="qwen2.5-coder:7b"
DEFAULT_REASONING_MODEL="deepseek-r1:7b"
DEFAULT_FAST_MODEL="llama3.2:3b"

# Code Execution Sandbox
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT_MB=512
